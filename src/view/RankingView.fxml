<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.RankingController"
            styleClass="ranking-root"
            stylesheets="@ranking.css">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <!-- ENCABEZADO -->
    <top>
        <VBox spacing="6">

            <padding>
                <Insets top="0" right="0" bottom="15" left="0"/>
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="20">

                <Label text="Ranking"
                       styleClass="ranking-titulo"/>

                <Label maxWidth="Infinity"
                       HBox.hgrow="ALWAYS"/>

                <Button fx:id="btnCerrar"
                        text="Cerrar"
                        styleClass="ranking-btn-cerrar"
                        onAction="#cerrar"/>

            </HBox>

            <Label text="Las partidas más rápidas"
                   styleClass="ranking-subtitulo"/>

        </VBox>
    </top>

    <!-- TABLA -->
    <center>
        <TableView fx:id="tablaRanking"
                   styleClass="ranking-tabla">

            <columns>

                <TableColumn fx:id="colPosicion"
                             text="#"
                             prefWidth="70"
                             sortable="false"
                             style="-fx-alignment: CENTER;"/>

                <TableColumn fx:id="colJugador"
                             text="Jugador"
                             prefWidth="210"
                             sortable="false"/>

                <TableColumn fx:id="colTiempo"
                             text="Tiempo"
                             prefWidth="110"
                             sortable="false"
                             style="-fx-alignment: CENTER;"/>

                <TableColumn fx:id="colFecha"
                             text="Fecha y hora"
                             prefWidth="230"
                             sortable="false"
                             style="-fx-alignment: CENTER;"/>

            </columns>

        </TableView>
    </center>

</BorderPane>
