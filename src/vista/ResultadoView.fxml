<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="co.edu.poli.Allten.Controlador.ResultadoController"
      styleClass="resultado-root"
      stylesheets="@resultado.css"
      alignment="TOP_CENTER"
      spacing="8"
      prefWidth="520">

    <padding>
        <Insets top="14" right="30" bottom="10" left="30"/>
    </padding>

    <!-- Si la pantalla es pequeña, solo la tarjeta se desplaza; los botones siempre se ven -->
    <ScrollPane fx:id="scrollTarjeta"
                styleClass="scroll-tarjeta"
                fitToWidth="true"
                hbarPolicy="NEVER"
                vbarPolicy="AS_NEEDED"
                VBox.vgrow="ALWAYS">

        <VBox alignment="TOP_CENTER" styleClass="contenedor-tarjeta">

            <!-- ============ TARJETA COMPARTIBLE (esto es lo que se exporta) ============ -->
            <VBox fx:id="tarjeta"
                  styleClass="tarjeta-resultado"
                  alignment="TOP_CENTER"
                  spacing="10"
                  prefWidth="440"
                  minWidth="440"
                  maxWidth="440">

                <VBox alignment="CENTER" spacing="0">
                    <Label text="All Ten" styleClass="marca"/>
                    <Label text="✓  ¡Reto completado!" styleClass="titulo-reto"/>
                </VBox>

                <!-- Jugador, fecha y tiempo en un solo panel -->
                <VBox alignment="CENTER" spacing="2" styleClass="panel-blanco" maxWidth="Infinity">
                    <Label fx:id="lblJugador" text="Jugador" styleClass="jugador-nombre"/>
                    <Label fx:id="lblFecha" text="" styleClass="fecha"/>
                    <Label text="TIEMPO TOTAL" styleClass="etiqueta">
                        <VBox.margin><Insets top="6"/></VBox.margin>
                    </Label>
                    <Label fx:id="lblTiempo" text="00:00" styleClass="tiempo-grande"/>
                    <Label fx:id="lblCategoria" text="RETO COMPLETADO" styleClass="badge-velocidad">
                        <VBox.margin><Insets top="4"/></VBox.margin>
                    </Label>
                </VBox>

                <!-- Los 10 objetivos conseguidos en una sola fila -->
                <VBox alignment="CENTER" spacing="6" styleClass="panel-blanco" maxWidth="Infinity">
                    <Label text="OBJETIVOS LOGRADOS  10 / 10" styleClass="etiqueta"/>
                    <FlowPane fx:id="panelNumeros"
                              hgap="5"
                              vgap="5"
                              alignment="CENTER"
                              prefWrapLength="360"
                              maxWidth="360"/>
                </VBox>

                <!-- Operaciones en dos columnas (solo si hay) -->
                <VBox fx:id="cajaOperaciones"
                      styleClass="panel-blanco"
                      alignment="CENTER"
                      spacing="4"
                      maxWidth="Infinity">

                    <Label text="OPERACIONES" styleClass="etiqueta"/>

                    <HBox alignment="TOP_CENTER" spacing="28">
                        <Label fx:id="lblOperaciones" styleClass="texto-operaciones"/>
                        <Label fx:id="lblOperaciones2" styleClass="texto-operaciones"/>
                    </HBox>
                </VBox>

                <Label text="¿Puedes superarme?" styleClass="pie-tarjeta"/>

            </VBox>
        </VBox>
    </ScrollPane>

    <!-- ============ ACCIONES (no salen en la imagen) ============ -->
    <HBox alignment="CENTER" spacing="10">

        <Button fx:id="btnGuardar"
                text="Guardar imagen"
                styleClass="btn-primario"
                onAction="#guardarImagen"/>

        <Button text="Copiar imagen"
                styleClass="btn-secundario"
                onAction="#copiarImagen"/>

        <Button text="Cerrar"
                styleClass="btn-cerrar"
                onAction="#cerrar"/>
    </HBox>

    <Label fx:id="lblEstado" styleClass="estado" minHeight="16"/>

</VBox>