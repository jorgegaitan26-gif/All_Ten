<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!--
    Menu principal de All Ten.
    Fondo: cuaderno cuadriculado verde (el mismo de "Como jugar") con fichas de
    numeros y operadores flotando; tarjeta crema al centro con los 4 botones.
    Las fichas decorativas las crea MainSceneController.initialize().
-->
<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="co.edu.poli.Allten.Controlador.MainSceneController"
           styleClass="menu-root"
           stylesheets="@menu.css">

    <!-- Capa decorativa (no recibe clics) -->
    <Pane fx:id="capaDecoracion" mouseTransparent="true" pickOnBounds="false"/>

    <!-- Tarjeta central -->
    <VBox alignment="CENTER" spacing="10" styleClass="menu-tarjeta"
          maxWidth="470" maxHeight="-Infinity">

        <Label text="All Ten" styleClass="menu-titulo"/>
        <Label text="Forma los números del 1 al 10 con cuatro dígitos" styleClass="menu-subtitulo"
               wrapText="true" textAlignment="CENTER"/>

        <!-- Fila 1 … 10 (se llena en el controlador) -->
        <HBox fx:id="filaDiez" alignment="CENTER" spacing="6" styleClass="menu-fila-diez">
            <VBox.margin>
                <Insets top="6" bottom="12"/>
            </VBox.margin>
        </HBox>

        <!-- Botones: los cuatro comparten exactamente el mismo tamaño (ver .btn-menu) -->
        <VBox alignment="CENTER" spacing="14">

            <Button fx:id="btnRetoDiario" text="Reto diario"
                    onAction="#jugarRetoDiario"
                    styleClass="btn-menu, btn-menu-verde">
                <graphic><Label text="★" styleClass="menu-icono"/></graphic>
            </Button>

            <Button fx:id="btnPartidaLibre" text="Partida libre"
                    onAction="#jugarPartidaLibre"
                    styleClass="btn-menu, btn-menu-azul">
                <graphic><Label text="∞" styleClass="menu-icono"/></graphic>
            </Button>

            <Button fx:id="btnRanking" text="Ranking"
                    onAction="#abrirRanking"
                    styleClass="btn-menu, btn-menu-naranja">
                <graphic><Label text="#" styleClass="menu-icono"/></graphic>
            </Button>

            <Button fx:id="btnComoJugar" text="Cómo jugar"
                    onAction="#abrirInstrucciones"
                    styleClass="btn-menu, btn-menu-crema">
                <graphic><Label text="?" styleClass="menu-icono menu-icono-morado"/></graphic>
            </Button>

        </VBox>

        <Label text="¡Un reto nuevo cada día!" styleClass="menu-pie">
            <VBox.margin>
                <Insets top="10"/>
            </VBox.margin>
        </Label>

    </VBox>

</StackPane>
