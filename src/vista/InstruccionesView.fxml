<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!--
    "¿Cómo jugar?"
-->
<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="co.edu.poli.Allten.Controlador.InstruccionesController"
           styleClass="instrucciones-root"
           stylesheets="@instrucciones.css">

    <BorderPane styleClass="tarjeta-crema">
        <StackPane.margin>
            <Insets top="26" right="30" bottom="26" left="30"/>
        </StackPane.margin>

        <!-- ENCABEZADO -->
        <top>
            <HBox alignment="CENTER_LEFT" spacing="14" styleClass="header-bar">
                <Label text="?" styleClass="titulo-icono"/>
                <Label text="¿Cómo jugar?" styleClass="titulo-pantalla"/>
                <Label maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                <Button fx:id="btnVolver" text="← Volver" styleClass="btn-volver" onAction="#volver"/>
            </HBox>
        </top>

        <!-- CUERPO -->
        <center>
            <HBox spacing="22" styleClass="cuerpo">
                <BorderPane.margin>
                    <Insets top="18"/>
                </BorderPane.margin>

                <!-- MENU LATERAL -->
                <VBox fx:id="menuLateral" spacing="12" styleClass="menu-lateral" alignment="TOP_CENTER">
                    <Button fx:id="btnObjetivo"   text="Objetivo"        styleClass="btn-categoria" onAction="#mostrarObjetivo"/>
                    <Button fx:id="btnNumeros"    text="Números"         styleClass="btn-categoria" onAction="#mostrarNumeros"/>
                    <Button fx:id="btnOperadores" text="Operadores"      styleClass="btn-categoria" onAction="#mostrarOperadores"/>
                    <Button fx:id="btnComprobar"  text="Cómo comprobar"  styleClass="btn-categoria" onAction="#mostrarComprobar"/>
                    <Button fx:id="btnTiempo"     text="Tiempo"          styleClass="btn-categoria" onAction="#mostrarTiempo"/>
                </VBox>

                <!-- PANEL DE CONTENIDO -->
                <VBox styleClass="panel-contenido" spacing="14" HBox.hgrow="ALWAYS" minWidth="0">

                    <HBox alignment="CENTER_LEFT" spacing="12">
                        <Label fx:id="lblCategoria" styleClass="titulo-categoria"/>
                    </HBox>

                    <HBox spacing="20" VBox.vgrow="ALWAYS">

                        <!-- Texto + ejemplo -->
                        <VBox spacing="14" HBox.hgrow="ALWAYS" minWidth="0">
                            <Label fx:id="lblTexto" styleClass="texto-contenido"
                                   wrapText="true" maxWidth="Infinity"/>
                            <VBox fx:id="cajaEjemplo" styleClass="caja-ejemplo"
                                  spacing="6" alignment="CENTER_LEFT"/>
                        </VBox>

                        <!-- Imagen enmarcada -->
                        <StackPane styleClass="marco-imagen" alignment="CENTER"
                                   minWidth="250" prefWidth="250" maxWidth="250"
                                   maxHeight="-Infinity" HBox.hgrow="NEVER">
                            <ImageView fx:id="imagenContenido"
                                       fitWidth="226" fitHeight="190"
                                       preserveRatio="true" smooth="true"/>
                        </StackPane>

                    </HBox>

                    <!-- NAVEGACION -->
                    <HBox alignment="CENTER_RIGHT" spacing="12">
                        <Button fx:id="btnAnterior"  text="‹ Anterior"  styleClass="btn-nav" onAction="#anterior"/>
                        <Button fx:id="btnSiguiente" text="Siguiente ›" styleClass="btn-nav-primario" onAction="#siguiente"/>
                    </HBox>

                </VBox>

            </HBox>
        </center>

    </BorderPane>

</StackPane>
